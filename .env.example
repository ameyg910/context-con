# Copy to .env. Environment variables override this file. Never commit .env.
CRUSTDATA_API_KEY=
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
# Alternative documented free-tier model: gemini-3.8-flash (quota/access can differ).
# Use a Free Tier project/key. There is no per-request API flag that forces free billing.
# Paid-only models and automatic paid fallback are disabled in this build.
GEMINI_API_KEY=
# Local option: MODEL_PROVIDER=ollama and an explicitly selected tool-capable model.
# MODEL_NAME=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TOOL_MODE=structured
DATA_DIR=.local/runtime
SESSION_CREDITS=10
TURN_CREDITS=5
TURN_TOOL_CALLS=10
SESSION_TOOL_CALLS=40
TURN_MODEL_CALLS=10
SESSION_MODEL_CALLS=30
SESSION_MODEL_TOKENS=100000
MODEL_OUTPUT_TOKENS=2048
TURN_SECONDS=120
REQUEST_SECONDS=30
# Documented Free Tier input/output prices; configured rates, not an observed invoice.
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
